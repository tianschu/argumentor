# ArguMentor configuration example.
# The real file lives OUTSIDE this folder, so copying or zipping the project can never leak your key:
#   macOS / Linux : ~/.config/argumentor/env
#   Windows       : %APPDATA%\ArguMentor\env
# Create it with:  npm run setup      Verify it for free with:  npm run check
# Never commit, share or screenshot your real key.

DEEPSEEK_API_KEY=
# Use a model your account lists (npm run check prints them). Avoid non-pinned aliases for research runs.
DEEPSEEK_MODEL=deepseek-flash
PORT=4186

# Daily ceilings; they survive restarts (stored next to the config file).
MAX_PROVIDER_CALLS=300
MAX_DAILY_TOKENS=2000000
MAX_CONCURRENT=2
MAX_QUEUE=40

# Classroom mode (one server for a class). Default is loopback only.
# HOST=0.0.0.0
# ALLOWED_HOSTS=192.168.1.20
# ACCESS_CODE=choose-a-class-code

# Research options.
# REVIEW_MODE=multi            # multi | multi-nocoord | single  (ablation conditions)
# PROVIDER=mock                # offline template mode; NOT AI feedback
# DEEPSEEK_THINKING=disabled   # disabled | enabled | omit
